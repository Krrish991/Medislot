{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "medislot-frontend",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/landing-page",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://medislot-ji7o.onrender.com/api/:path*"
    }
  ]
}
