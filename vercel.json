{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "medislot-frontend",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://medislot-api.onrender.com/api/:path*"
    }
  ]
}
